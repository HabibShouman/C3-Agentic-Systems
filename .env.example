# Copy to .env locally. Never upload .env or API credentials.
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Optional alternative: PROVIDER=openai and MODEL=gpt-4.1-mini
OPENAI_API_KEY=
MIN_REQUEST_INTERVAL=6
# For a hosted Space, use its secret settings and set SERVER_NAME=0.0.0.0.
# DATA_DIR=path/to/your/records
